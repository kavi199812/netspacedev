---
import BaseLayout from '../layouts/BaseLayout.astro';
import { fetchProjects } from '../utils/api.js';

const projects = await fetchProjects();
---

<BaseLayout title="Projects">
  <div style="margin-bottom: 2rem;">
    <h1 style="font-size: var(--step-3); font-weight: 700; letter-spacing: -0.025em; margin-bottom: 0.5rem;">
      Projects
    </h1>
    <p style="color: var(--fg-muted); font-size: var(--step-0);">
      Software applications, distributed systems, and mobile platforms engineered for clients.
    </p>
  </div>

  <!-- Category Filter Buttons in astro-narrow pill style -->
  <div style="display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.75rem;" id="filterBar">
    <button class="pill-btn active" data-category="all">All</button>
    <button class="pill-btn" data-category="Web Development">Web</button>
    <button class="pill-btn" data-category="Mobile App">Mobile</button>
    <button class="pill-btn" data-category="Enterprise Software">Enterprise</button>
    <button class="pill-btn" data-category="AI & Healthcare">AI & Healthcare</button>
  </div>

  <div class="cards-list" id="projectsContainer">
    {projects.map((p) => (
      <article class="entry-card project-item" data-category={p.category} id={p.slug}>
        <div class="entry-card-layout">
          <div class="entry-card-body">
            <h2 class="entry-card-title">{p.title}</h2>
            <p class="entry-card-desc">{p.summary}</p>

            {p.description ? (
              <p style="font-size: 0.85rem; color: var(--fg-muted); line-height: 1.6; background-color: var(--muted); padding: 0.75rem; border-radius: var(--radius-xs); border: 1px solid var(--border);">
                {p.description}
              </p>
            ) : null}

            <div class="entry-card-meta">
              <span class="meta-tag" style="color: var(--accent-text);">{p.category}</span>
              
              {p.client_name ? (
                <span>Client: <strong>{p.client_name}</strong></span>
              ) : null}

              {p.technologies && p.technologies.split(',').map((tech) => (
                <span class="meta-tag">#{tech.trim()}</span>
              ))}

              {p.live_url ? (
                <a href={p.live_url} target="_blank" rel="noopener noreferrer" style="color: var(--accent-text); font-weight: 500; margin-left: auto;">
                  Live Demo ↗
                </a>
              ) : null}
            </div>
          </div>

          {p.image_url ? (
            <div class="entry-card-thumb-wrap">
              <img src={p.image_url} alt={p.title} class="entry-card-thumb" loading="lazy" />
            </div>
          ) : null}
        </div>
      </article>
    ))}
  </div>
</BaseLayout>

<style>
  .pill-btn.active {
    background-color: var(--accent);
    color: var(--accent-contrast);
    border-color: var(--accent);
    font-weight: 600;
  }
</style>

<script>
  const filterBtns = document.querySelectorAll('#filterBar .pill-btn');
  const projectItems = document.querySelectorAll('.project-item') as NodeListOf<HTMLElement>;

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      filterBtns.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');

      const category = btn.getAttribute('data-category') || 'all';

      projectItems.forEach((item) => {
        const itemCat = item.getAttribute('data-category') || '';
        if (category === 'all' || itemCat.toLowerCase() === category.toLowerCase()) {
          item.style.display = 'block';
        } else {
          item.style.display = 'none';
        }
      });
    });
  });
</script>
