---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Contact">
  <div style="margin-bottom: 2rem;">
    <h1 style="font-size: var(--step-3); font-weight: 700; letter-spacing: -0.025em; margin-bottom: 0.5rem;">
      Contact Us
    </h1>
    <p style="color: var(--fg-muted); font-size: var(--step-0);">
      Send an inquiry for your software project or engineering requirements.
    </p>
  </div>

  <section class="profile-card" style="margin-bottom: 2rem;">
    <div id="contactAlert" style="display: none; padding: 0.75rem 1rem; border-radius: var(--radius-xs); margin-bottom: 1.25rem; font-size: var(--step--1);"></div>

    <form id="contactForm">
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1rem;">
        <div>
          <label style="display: block; font-size: var(--step--1); font-weight: 500; margin-bottom: 0.35rem; color: var(--fg);">Your Name *</label>
          <input type="text" name="name" required placeholder="Dilshan Fernando" style="width: 100%; padding: 0.6rem 0.85rem; background: var(--muted); border: 1px solid var(--border); border-radius: var(--radius-xs); color: var(--fg); font-size: var(--step--1); outline: none;" />
        </div>
        <div>
          <label style="display: block; font-size: var(--step--1); font-weight: 500; margin-bottom: 0.35rem; color: var(--fg);">Work Email *</label>
          <input type="email" name="email" required placeholder="name@company.com" style="width: 100%; padding: 0.6rem 0.85rem; background: var(--muted); border: 1px solid var(--border); border-radius: var(--radius-xs); color: var(--fg); font-size: var(--step--1); outline: none;" />
        </div>
      </div>

      <div style="margin-bottom: 1rem;">
        <label style="display: block; font-size: var(--step--1); font-weight: 500; margin-bottom: 0.35rem; color: var(--fg);">Subject / Service</label>
        <select name="subject" style="width: 100%; padding: 0.6rem 0.85rem; background: var(--muted); border: 1px solid var(--border); border-radius: var(--radius-xs); color: var(--fg); font-size: var(--step--1); outline: none;">
          <option value="Custom Web App Development">Custom Web App Development</option>
          <option value="Mobile App (iOS / Android)">Mobile App (iOS / Android)</option>
          <option value="Cloud Architecture & DevOps">Cloud Architecture & DevOps</option>
          <option value="Backend & Database Engineering">Backend & Database Engineering</option>
          <option value="General Inquiry">General Inquiry</option>
        </select>
      </div>

      <div style="margin-bottom: 1.25rem;">
        <label style="display: block; font-size: var(--step--1); font-weight: 500; margin-bottom: 0.35rem; color: var(--fg);">Message *</label>
        <textarea name="message" required rows="4" placeholder="Briefly describe your project scope and timeline..." style="width: 100%; padding: 0.6rem 0.85rem; background: var(--muted); border: 1px solid var(--border); border-radius: var(--radius-xs); color: var(--fg); font-size: var(--step--1); outline: none; resize: vertical;"></textarea>
      </div>

      <button type="submit" id="submitBtn" class="pill-btn" style="background-color: var(--accent); color: var(--accent-contrast); font-weight: 600; cursor: pointer; border: none; padding: 0.6rem 1.25rem;">
        Send Message ➔
      </button>
    </form>
  </section>

  <div class="cards-list">
    <article class="entry-card" style="padding: 1.25rem 1.5rem;">
      <h3 class="entry-card-title" style="font-size: var(--step-0); margin-bottom: 0.35rem;">NetSpace Global (Pvt) Ltd</h3>
      <p class="entry-card-desc">
        Email: <a href="mailto:hello@netspacedev.com" style="color: var(--accent-text);">hello@netspacedev.com</a> • WhatsApp / Direct: <a href="https://wa.me/94762785313" style="color: var(--accent-text);">+94 76 278 5313</a>
      </p>
    </article>
  </div>
</BaseLayout>

<script>
  import { getApiBaseUrl } from '../utils/api.js';

  const form = document.getElementById('contactForm') as HTMLFormElement | null;
  const alertBox = document.getElementById('contactAlert') as HTMLElement | null;
  const submitBtn = document.getElementById('submitBtn') as HTMLButtonElement | null;

  if (form && alertBox && submitBtn) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const origText = submitBtn.textContent;
      submitBtn.textContent = 'Sending...';
      submitBtn.disabled = true;

      const fd = new FormData(form);
      const payload = {
        name: fd.get('name'),
        email: fd.get('email'),
        subject: fd.get('subject'),
        message: fd.get('message')
      };

      try {
        const apiUrl = `${getApiBaseUrl()}/contact.php`;
        const res = await fetch(apiUrl, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });

        const data = await res.json();

        if (res.ok && data.success) {
          alertBox.style.display = 'block';
          alertBox.style.backgroundColor = 'rgba(63, 185, 80, 0.15)';
          alertBox.style.border = '1px solid rgba(63, 185, 80, 0.4)';
          alertBox.style.color = '#7ee787';
          alertBox.textContent = data.message || 'Message sent successfully!';
          form.reset();
        } else {
          throw new Error(data.error || 'Failed to submit.');
        }
      } catch (err: any) {
        alertBox.style.display = 'block';
        alertBox.style.backgroundColor = 'rgba(248, 81, 73, 0.15)';
        alertBox.style.border = '1px solid rgba(248, 81, 73, 0.4)';
        alertBox.style.color = '#ff7b72';
        alertBox.textContent = err.message || 'Failed to submit. Please try again.';
      } finally {
        submitBtn.textContent = origText;
        submitBtn.disabled = false;
      }
    });
  }
</script>
