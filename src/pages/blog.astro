---
import BaseLayout from '../layouts/BaseLayout.astro';
import { fetchBlogs } from '../utils/api.js';

const blogs = await fetchBlogs();
---

<BaseLayout title="Posts & Insights">
  <div style="margin-bottom: 2rem;">
    <h1 style="font-size: var(--step-3); font-weight: 700; letter-spacing: -0.025em; margin-bottom: 0.5rem;">
      Posts & Articles
    </h1>
    <p style="color: var(--fg-muted); font-size: var(--step-0);">
      Writing, architecture notes, and software engineering deep dives.
    </p>
  </div>

  <!-- Cards List matching screenshot -->
  <div class="cards-list">
    {blogs.map((b) => (
      <article class="entry-card" id={b.slug}>
        <div class="entry-card-layout">
          <div class="entry-card-body">
            <h2 class="entry-card-title">{b.title}</h2>
            <p class="entry-card-desc">{b.excerpt}</p>

            {b.content ? (
              <details style="margin-top: 0.5rem; font-size: var(--step--1); color: var(--fg-muted);">
                <summary style="cursor: pointer; color: var(--accent-text); font-weight: 500;">
                  Read Article ↓
                </summary>
                <div style="margin-top: 0.75rem; padding: 1rem; background-color: var(--muted); border-radius: var(--radius-xs); border: 1px solid var(--border); line-height: 1.7; color: var(--fg); white-space: pre-line;">
                  {b.content}
                </div>
              </details>
            ) : null}

            <div class="entry-card-meta">
              <span class="meta-item">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect width="18" height="18" x="3" y="4" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/>
                </svg>
                <time>{b.created_at ? new Date(b.created_at).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' }) : 'June 27, 2026'}</time>
              </span>

              {b.read_time ? (
                <span class="meta-item">⏱ {b.read_time}</span>
              ) : null}

              {b.tags && b.tags.split(',').map((t) => (
                <span class="meta-tag">#{t.trim()}</span>
              ))}
            </div>
          </div>

          {b.cover_image ? (
            <div class="entry-card-thumb-wrap">
              <img src={b.cover_image} alt={b.title} class="entry-card-thumb" loading="lazy" />
            </div>
          ) : null}
        </div>
      </article>
    ))}
  </div>
</BaseLayout>
