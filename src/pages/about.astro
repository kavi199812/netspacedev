---
import BaseLayout from '../layouts/BaseLayout.astro';

const principles = [
  {
    title: 'Performance-First',
    desc: 'We reject bloated frameworks and slow runtimes. Every line of code is structured to load fast and execute cleanly.'
  },
  {
    title: 'Reliable Backend Logic',
    desc: 'From parameterized SQL queries and CSRF tokens to robust authentication mechanisms, security is built into our software from day one.'
  },
  {
    title: 'Maintainable Codebases',
    desc: 'We build clear, modular systems that your internal teams can easily maintain, extend, and scale as your user base expands.'
  },
  {
    title: 'Transparent Delivery',
    desc: 'Direct communication with software engineers, weekly demo iterations, and transparent delivery milestones.'
  }
];
---

<BaseLayout title="About Us">
  <div style="margin-bottom: 2rem;">
    <h1 style="font-size: var(--step-3); font-weight: 700; letter-spacing: -0.025em; margin-bottom: 0.5rem;">
      About NetSpace Global
    </h1>
    <p style="color: var(--fg-muted); font-size: var(--step-0);">
      NetSpace Global (Pvt) Ltd is a software engineering company based in Sri Lanka, delivering modern digital solutions worldwide.
    </p>
  </div>

  <section class="profile-card" style="margin-bottom: 2rem;">
    <h2 style="font-size: var(--step-1); font-weight: 600; margin-bottom: 0.75rem;">Company Overview</h2>
    <p style="color: var(--fg-muted); font-size: var(--step--1); line-height: 1.7; margin-bottom: 1rem;">
      Registered as <strong>NetSpace Global (Pvt) Ltd</strong>, we engineer high-performance web platforms, enterprise systems, and custom software architectures. We combine minimalist, fluid user interfaces with scalable database infrastructure and cloud deployment.
    </p>
    <div style="display: flex; flex-wrap: wrap; gap: 0.4rem;">
      <span class="meta-tag">Astro v7</span>
      <span class="meta-tag">PHP 8.4</span>
      <span class="meta-tag">MySQL</span>
      <span class="meta-tag">Docker</span>
      <span class="meta-tag">Hostinger</span>
      <span class="meta-tag">TailwindCSS</span>
    </div>
  </section>

  <h2 class="content-section-title" style="margin-bottom: 1rem;">Core Engineering Principles</h2>

  <div class="cards-list">
    {principles.map((p) => (
      <article class="entry-card" style="padding: 1.25rem 1.5rem;">
        <h3 class="entry-card-title" style="font-size: var(--step-0); margin-bottom: 0.4rem;">{p.title}</h3>
        <p class="entry-card-desc" style="-webkit-line-clamp: none;">{p.desc}</p>
      </article>
    ))}
  </div>
</BaseLayout>
