---
import BaseLayout from '../layouts/BaseLayout.astro';

const services = [
  {
    title: 'Custom Web Applications',
    tag: 'Web & SaaS',
    desc: 'High-performance cloud platforms, dashboards, and enterprise portals engineered for speed, security, and scalability.',
    features: ['Islands Architecture for instant load speeds', 'Dynamic Database-Driven Dashboards', 'RESTful & GraphQL API Integration', 'Payment & CRM Workflows']
  },
  {
    title: 'Cross-Platform Mobile Apps',
    tag: 'iOS & Android',
    desc: 'Engaging, responsive mobile applications built for both iOS and Android platforms, featuring offline synchronization and push notifications.',
    features: ['React Native / Hybrid Development', 'Native Camera, GPS & Bluetooth APIs', 'Offline-First Local Storage', 'Automated Store Pipelines']
  },
  {
    title: 'Database Architecture & Backend',
    tag: 'PHP & MySQL',
    desc: 'Scalable data models, high-performance query optimization, and secure server-side logic using modern PHP 8.4 and MySQL/MariaDB.',
    features: ['Relational Schema Design & Normalization', 'High-Speed Query Caching with Redis', 'Automated Backups & Migration Workflows', 'Strict Access Control & Data Encryption']
  },
  {
    title: 'Cloud DevOps & Hosting Solutions',
    tag: 'Hostinger & Cloud',
    desc: 'Reliable deployment engineering ensuring zero downtime, SSL certificates, automated Git webhooks, and optimal CDN caching.',
    features: ['Hostinger Shared, Cloud & VPS Deployment', 'Git CI/CD Pipeline Automation', 'Domain, DNS & HTTPS Security Configuration', 'Server Monitoring & Alerting']
  }
];
---

<BaseLayout title="Services">
  <div style="margin-bottom: 2rem;">
    <h1 style="font-size: var(--step-3); font-weight: 700; letter-spacing: -0.025em; margin-bottom: 0.5rem;">
      Services
    </h1>
    <p style="color: var(--fg-muted); font-size: var(--step-0);">
      Full-lifecycle software engineering capabilities tailored for modern businesses.
    </p>
  </div>

  <div class="cards-list">
    {services.map((s) => (
      <article class="entry-card" style="padding: 1.5rem;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.6rem;">
          <span class="meta-tag" style="color: var(--accent-text);">{s.tag}</span>
        </div>

        <h2 class="entry-card-title" style="margin-bottom: 0.5rem;">{s.title}</h2>
        <p class="entry-card-desc" style="-webkit-line-clamp: none; margin-bottom: 1.25rem;">
          {s.desc}
        </p>

        <ul style="list-style: none; display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 0.5rem; border-top: 1px solid var(--border); padding-top: 1rem;">
          {s.features.map((f) => (
            <li style="display: flex; align-items: center; gap: 0.4rem; font-size: var(--step--1); color: var(--fg-muted);">
              <span style="color: var(--accent-text);">✓</span>
              <span>{f}</span>
            </li>
          ))}
        </ul>
      </article>
    ))}
  </div>
</BaseLayout>
