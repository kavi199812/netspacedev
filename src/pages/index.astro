---
import BaseLayout from '../layouts/BaseLayout.astro';
import { fetchProjects, fetchBlogs } from '../utils/api.js';

const allProjects = await fetchProjects();
const featuredProjects = allProjects.slice(0, 2);
const allBlogs = await fetchBlogs();
const recentBlogs = allBlogs.slice(0, 2);
---

<BaseLayout title="Astro Narrow">
  <!-- Profile Header Card (Exact Replica of User Screenshot) -->
  <section class="profile-card">
    <div class="profile-card-inner">
      <!-- Circular Avatar / Logo -->
      <div class="profile-avatar" style="padding: 18px; display: grid; place-items: center;">
        <img src="/logo-white.png" alt="NetSpace Logo" style="width: 100%; height: 100%; object-fit: contain;" />
      </div>

      <!-- Info Details -->
      <div class="profile-info">
        <h1 class="profile-title">NetSpace Dev</h1>
        <p class="profile-subtitle">A clean and minimal software development company</p>
        <p class="profile-bio">
          Writing, projects, and software systems — a compact space for digital ideas that keep their shape.
        </p>

        <!-- Social Action Pills -->
        <div class="profile-actions">
          <a href="https://github.com/" target="_blank" rel="noopener noreferrer" class="pill-btn">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 .297c-6.63 0-12 5.373-12 12c0 5.303 3.438 9.8 8.205 11.385c.6.113.82-.258.82-.577c0-.285-.01-1.04-.015-2.04c-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729c1.205.084 1.838 1.236 1.838 1.236c1.07 1.835 2.809 1.305 3.495.998c.108-.776.417-1.305.76-1.605c-2.665-.3-5.466-1.332-5.466-5.93c0-1.31.465-2.38 1.235-3.22c-.135-.303-.54-1.523.105-3.176c0 0 1.005-.322 3.3 1.23c.96-.267 1.98-.399 3-.405c1.02.006 2.04.138 3 .405c2.28-1.552 3.285-1.23 3.285-1.23c.645 1.653.24 2.873.12 3.176c.765.84 1.23 1.91 1.23 3.22c0 4.61-2.805 5.625-5.475 5.92c.42.36.81 1.096.81 2.22c0 1.606-.015 2.896-.015 3.286c0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/>
            </svg>
            <span>GitHub</span>
          </a>

          <a href="mailto:hello@netspacedev.com" class="pill-btn">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
            </svg>
            <span>Email</span>
          </a>

          <a href="/contact" class="pill-btn">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
            </svg>
            <span>Contact</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Recent Posts Section (Identical to Screenshot) -->
  <section class="content-section">
    <h2 class="content-section-title">Recent Posts</h2>

    <div class="cards-list">
      {recentBlogs.map((b, idx) => (
        <article class="entry-card">
          <a href={`/blog#${b.slug}`}>
            <div class="entry-card-layout">
              <div class="entry-card-body">
                <h3 class="entry-card-title">{b.title}</h3>
                <p class="entry-card-desc">{b.excerpt}</p>

                <div class="entry-card-meta">
                  <span class="meta-item">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <rect width="18" height="18" x="3" y="4" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/>
                    </svg>
                    <time>{b.created_at ? new Date(b.created_at).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' }) : 'June 27, 2026'}</time>
                  </span>

                  {b.tags && b.tags.split(',').slice(0, 2).map((t) => (
                    <span class="meta-tag">#{t.trim()}</span>
                  ))}
                </div>
              </div>

              <!-- 16:9 Thumbnail on the right (like in screenshot) -->
              {b.cover_image ? (
                <div class="entry-card-thumb-wrap">
                  <img src={b.cover_image} alt={b.title} class="entry-card-thumb" loading="lazy" />
                </div>
              ) : null}
            </div>
          </a>
        </article>
      ))}
    </div>

    <!-- Centered View All Pill Button -->
    <div class="view-all-wrap">
      <a href="/blog" class="view-all-btn">
        <span>View all</span>
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 12h14m-7-7 7 7-7 7"/>
        </svg>
      </a>
    </div>
  </section>

  <!-- Featured Projects Section (Same Exact Layout) -->
  <section class="content-section">
    <h2 class="content-section-title">Featured Projects</h2>

    <div class="cards-list">
      {featuredProjects.map((p) => (
        <article class="entry-card">
          <a href={`/projects#${p.slug}`}>
            <div class="entry-card-layout">
              <div class="entry-card-body">
                <h3 class="entry-card-title">{p.title}</h3>
                <p class="entry-card-desc">{p.summary}</p>

                <div class="entry-card-meta">
                  <span class="meta-item">
                    <span class="meta-tag">{p.category}</span>
                  </span>

                  {p.technologies && p.technologies.split(',').slice(0, 2).map((tech) => (
                    <span class="meta-tag">#{tech.trim()}</span>
                  ))}
                </div>
              </div>

              {p.image_url ? (
                <div class="entry-card-thumb-wrap">
                  <img src={p.image_url} alt={p.title} class="entry-card-thumb" loading="lazy" />
                </div>
              ) : null}
            </div>
          </a>
        </article>
      ))}
    </div>

    <div class="view-all-wrap">
      <a href="/projects" class="view-all-btn">
        <span>View all</span>
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 12h14m-7-7 7 7-7 7"/>
        </svg>
      </a>
    </div>
  </section>
</BaseLayout>
