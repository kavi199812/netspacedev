---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroVideo from '../components/HeroVideo.astro';
import TechStackSlider from '../components/TechStackSlider.astro';
import ServicesShowcase from '../components/ServicesShowcase.astro';
import FaqSection from '../components/FaqSection.astro';
import { fetchProjects, fetchBlogs } from '../utils/api.js';

const allProjects = await fetchProjects();
const featuredProjects = allProjects.slice(0, 2);
const allBlogs = await fetchBlogs();
const recentBlogs = allBlogs.slice(0, 2);
---

<BaseLayout title="NetSpace Dev">
  <!-- Featured Hero YouTube Video -->
  <HeroVideo videoId="pjpOIqM0_jU" />

  <!-- Services Showcase Section (Web Design & Development Highlights) -->
  <ServicesShowcase />

  <!-- Technologies & Stacks Slider -->
  <TechStackSlider />

  <!-- Featured Projects Section (Above Recent Posts) -->
  <section class="content-section">
    <h2 class="content-section-title">Featured Projects</h2>

    <div class="cards-list">
      {featuredProjects.map((p) => (
        <article class="entry-card">
          <a href={`/projects#${p.slug}`}>
            <div class="entry-card-layout">
              <div class="entry-card-body">
                <h3 class="entry-card-title">{p.title}</h3>
                <p class="entry-card-desc">{p.summary}</p>

                <div class="entry-card-meta">
                  <span class="meta-item">
                    <span class="meta-tag">{p.category}</span>
                  </span>

                  {p.technologies && p.technologies.split(',').slice(0, 2).map((tech) => (
                    <span class="meta-tag">#{tech.trim()}</span>
                  ))}
                </div>
              </div>

              {p.image_url ? (
                <div class="entry-card-thumb-wrap">
                  <img src={p.image_url} alt={p.title} class="entry-card-thumb" loading="lazy" />
                </div>
              ) : null}
            </div>
          </a>
        </article>
      ))}
    </div>

    <div class="view-all-wrap">
      <a href="/projects" class="view-all-btn">
        <span>View all</span>
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 12h14m-7-7 7 7-7 7"/>
        </svg>
      </a>
    </div>
  </section>

  <!-- FAQ Section (Directly Above Recent Posts) -->
  <FaqSection />

  <!-- Recent Posts Section (At the Bottom) -->
  <section class="content-section">
    <h2 class="content-section-title">Recent Posts</h2>

    <div class="cards-list">
      {recentBlogs.map((b, idx) => (
        <article class="entry-card">
          <a href={`/blog#${b.slug}`}>
            <div class="entry-card-layout">
              <div class="entry-card-body">
                <h3 class="entry-card-title">{b.title}</h3>
                <p class="entry-card-desc">{b.excerpt}</p>

                <div class="entry-card-meta">
                  <span class="meta-item">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <rect width="18" height="18" x="3" y="4" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/>
                    </svg>
                    <time>{b.created_at ? new Date(b.created_at).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' }) : 'June 27, 2026'}</time>
                  </span>

                  {b.tags && b.tags.split(',').slice(0, 2).map((t) => (
                    <span class="meta-tag">#{t.trim()}</span>
                  ))}
                </div>
              </div>

              <!-- 16:9 Thumbnail on the right -->
              {b.cover_image ? (
                <div class="entry-card-thumb-wrap">
                  <img src={b.cover_image} alt={b.title} class="entry-card-thumb" loading="lazy" />
                </div>
              ) : null}
            </div>
          </a>
        </article>
      ))}
    </div>

    <!-- Centered View All Pill Button -->
    <div class="view-all-wrap">
      <a href="/blog" class="view-all-btn">
        <span>View all</span>
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 12h14m-7-7 7 7-7 7"/>
        </svg>
      </a>
    </div>
  </section>
</BaseLayout>
