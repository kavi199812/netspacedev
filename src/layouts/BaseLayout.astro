---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { 
  title, 
  description = "NetSpace - Modern bespoke software development, web applications, mobile platforms, and enterprise cloud solutions." 
} = Astro.props;

const currentPath = Astro.url.pathname;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta name="generator" content={Astro.generator} />
  
  <title>{title} | NetSpace Software Development</title>
  <meta name="description" content={description} />
  <meta property="og:title" content={`${title} | NetSpace Software Development`} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />

  <!-- Prevent Theme Flash -->
  <script is:inline>
    const theme = (() => {
      if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
        return localStorage.getItem('theme');
      }
      return 'dark';
    })();
    document.documentElement.setAttribute('data-theme', theme);
  </script>
</head>
<body>
  <div class="narrow-container">
    <Header currentPath={currentPath} />
    
    <main>
      <slot />
    </main>

    <Footer />
  </div>
</body>
</html>
