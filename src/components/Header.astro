---
interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

const navItems = [
  { 
    label: 'Services', 
    href: '/services',
    icon: `<svg width="1em" height="1em" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="14" x="2" y="7" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>`
  },
  { 
    label: 'Projects', 
    href: '/projects',
    icon: `<svg width="1em" height="1em" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83z"/><path d="M2 12a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 12"/><path d="M2 17a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 17"/></svg>`
  },
  { 
    label: 'Posts', 
    href: '/blog',
    icon: `<svg width="1em" height="1em" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 22a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.704.706l3.588 3.588A2.4 2.4 0 0 1 20 8v12a2 2 0 0 1-2 2z"/><path d="M14 2v5a1 1 0 0 0 1 1h5M10 9H8m8 4H8m8 4H8"/></svg>`
  },
  { 
    label: 'About', 
    href: '/about',
    icon: `<svg width="1em" height="1em" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>`
  },
  { 
    label: 'Contact', 
    href: '/contact',
    icon: `<svg width="1em" height="1em" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>`
  },
];
---

<header class="header-sticky">
  <div class="nav-shell">
    <!-- Brand -->
    <a href="/" class="brand-badge">
      <span class="brand-icon-box">
        <img src="/logo-dark.png" alt="NetSpace Logo" class="brand-logo-dark" />
        <img src="/logo-white.png" alt="NetSpace Logo" class="brand-logo-light" />
      </span>
      <span>NetSpace Dev</span>
    </a>

    <!-- Primary Nav Items with Lucide Icons -->
    <nav class="nav-primary" aria-label="Primary Navigation">
      {navItems.map((item) => (
        <a 
          href={item.href} 
          class={`nav-link ${currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href)) ? 'active' : ''}`}
        >
          <Fragment set:html={item.icon} />
          <span>{item.label}</span>
        </a>
      ))}
    </nav>

    <!-- Actions: Theme Switcher & Mobile Menu -->
    <div class="nav-actions">
      <button type="button" class="icon-btn" id="themeSwitchBtn" aria-label="Toggle theme" title="Toggle theme">
        <svg id="themeIconSun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/>
        </svg>
        <svg id="themeIconMoon" style="display: none;" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>
        </svg>
      </button>

      <button type="button" class="icon-btn" id="mobileToggle" style="display: none;" aria-label="Toggle mobile menu">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="18" y2="18"/>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer -->
  <div class="mobile-nav-panel" id="mobilePanel">
    {navItems.map((item) => (
      <a 
        href={item.href} 
        class={`nav-link ${currentPath === item.href ? 'active' : ''}`}
        style="padding: 0.6rem 0.85rem;"
      >
        <Fragment set:html={item.icon} />
        <span>{item.label}</span>
      </a>
    ))}
  </div>
</header>

<style>
  @media (max-width: 767px) {
    #mobileToggle {
      display: grid !important;
    }
  }
</style>

<script>
  // Mobile toggle
  const mobileToggle = document.getElementById('mobileToggle');
  const mobilePanel = document.getElementById('mobilePanel');
  if (mobileToggle && mobilePanel) {
    mobileToggle.addEventListener('click', () => {
      mobilePanel.classList.toggle('open');
    });
  }

  // Theme switch
  const themeBtn = document.getElementById('themeSwitchBtn');
  const sun = document.getElementById('themeIconSun');
  const moon = document.getElementById('themeIconMoon');

  function syncThemeIcons() {
    const isDark = document.documentElement.getAttribute('data-theme') !== 'light';
    if (sun && moon) {
      sun.style.display = isDark ? 'block' : 'none';
      moon.style.display = isDark ? 'none' : 'block';
    }
  }

  syncThemeIcons();

  if (themeBtn) {
    themeBtn.addEventListener('click', () => {
      const isDark = document.documentElement.getAttribute('data-theme') !== 'light';
      const newTheme = isDark ? 'light' : 'ink';
      document.documentElement.setAttribute('data-theme', newTheme);
      localStorage.setItem('theme', newTheme);
      syncThemeIcons();
    });
  }
</script>
