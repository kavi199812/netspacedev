---
// Tech Stack Slider Component with matching icons and pill button border-radius
const techStacks = [
  {
    name: 'Node.js',
    icon: 'nodejs',
    color: '#68a063'
  },
  {
    name: 'PHP 8.4',
    icon: 'php',
    color: '#8993be'
  },
  {
    name: 'React',
    icon: 'react',
    color: '#61dafb'
  },
  {
    name: 'MongoDB',
    icon: 'mongodb',
    color: '#47a248'
  },
  {
    name: 'MySQL',
    icon: 'mysql',
    color: '#00758f'
  },
  {
    name: 'Cloudflare',
    icon: 'cloudflare',
    color: '#f38020'
  },
  {
    name: 'Bootstrap',
    icon: 'bootstrap',
    color: '#7952b3'
  },
  {
    name: 'TailwindCSS',
    icon: 'tailwind',
    color: '#38bdf8'
  },
  {
    name: 'Astro',
    icon: 'astro',
    color: '#ff5d01'
  },
  {
    name: 'TypeScript',
    icon: 'typescript',
    color: '#3178c6'
  },
  {
    name: 'Docker',
    icon: 'docker',
    color: '#2496ed'
  },
  {
    name: 'Python',
    icon: 'python',
    color: '#387eb8'
  },
  {
    name: 'Redis',
    icon: 'redis',
    color: '#dc382d'
  }
];

// Duplicate for infinite seamless marquee loop
const duplicatedStacks = [...techStacks, ...techStacks];
---

<section class="tech-stack-section">
  <div class="tech-stack-head">
    <span class="tech-stack-title">Technologies & Stacks</span>
  </div>

  <div class="marquee-wrapper">
    <div class="marquee-track">
      {duplicatedStacks.map((tech) => (
        <div class="tech-pill">
          <!-- Matching SVG Icon for each Technology -->
          {tech.icon === 'nodejs' && (
            <svg width="16" height="16" viewBox="0 0 24 24" fill={tech.color}>
              <path d="M12 2l9 5.2v10.4L12 22.8 3 17.6V7.2L12 2zm0 2.3L5 8.3v7.4l7 4 7-4V8.3l-7-4zm-1 4.7h2v5.5l3-1.8v2.1l-5 3v-8.8z"/>
            </svg>
          )}

          {tech.icon === 'php' && (
            <svg width="18" height="16" viewBox="0 0 24 24" fill="none" stroke={tech.color} stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="m18 8-3 8h-2l3-8h2z"/>
              <path d="M6 12h2a2 2 0 1 0 0-4H5v8h2v-4z"/>
              <path d="M13 12h2a2 2 0 1 0 0-4h-3v8h2v-4z"/>
            </svg>
          )}

          {tech.icon === 'react' && (
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke={tech.color} stroke-width="1.8">
              <ellipse cx="12" cy="12" rx="10" ry="4.2"/>
              <ellipse cx="12" cy="12" rx="10" ry="4.2" transform="rotate(60 12 12)"/>
              <ellipse cx="12" cy="12" rx="10" ry="4.2" transform="rotate(120 12 12)"/>
              <circle cx="12" cy="12" r="2" fill={tech.color}/>
            </svg>
          )}

          {tech.icon === 'mongodb' && (
            <svg width="15" height="16" viewBox="0 0 24 24" fill={tech.color}>
              <path d="M12 1.5s-6 5.5-6 11.5c0 4 2.5 7 5.5 8.5v1.5c0 .3.2.5.5.5s.5-.2.5-.5V21.5c3-1.5 5.5-4.5 5.5-8.5 0-6-6-11.5-6-11.5zm.3 17.9c-2.4-1.2-4.3-3.7-4.3-6.9 0-3.9 3.2-7.8 4.3-9.1v16z"/>
            </svg>
          )}

          {tech.icon === 'mysql' && (
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke={tech.color} stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <ellipse cx="12" cy="5" rx="9" ry="3"/>
              <path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"/>
              <path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/>
            </svg>
          )}

          {tech.icon === 'cloudflare' && (
            <svg width="17" height="16" viewBox="0 0 24 24" fill={tech.color}>
              <path d="M19.35 10.04C18.67 6.59 15.64 4 12 4 9.11 4 6.6 5.64 5.35 8.04 2.34 8.36 0 10.91 0 14c0 3.31 2.69 6 6 6h13c2.76 0 5-2.24 5-5 0-2.64-2.05-4.78-4.65-4.96z"/>
            </svg>
          )}

          {tech.icon === 'bootstrap' && (
            <svg width="16" height="16" viewBox="0 0 24 24" fill={tech.color}>
              <path d="M4 4a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v16a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V4zm5.5 3v10h4.4c2 0 3.3-1.1 3.3-2.7 0-1.2-.7-2-1.9-2.3 1-.3 1.5-1.1 1.5-2.1 0-1.6-1.3-2.9-3.2-2.9H9.5zm2.1 1.8h2c.8 0 1.3.5 1.3 1.2 0 .8-.5 1.2-1.3 1.2h-2V8.8zm0 4.2h2.3c.9 0 1.5.5 1.5 1.3 0 .9-.6 1.4-1.5 1.4h-2.3V13z"/>
            </svg>
          )}

          {tech.icon === 'tailwind' && (
            <svg width="17" height="16" viewBox="0 0 24 24" fill={tech.color}>
              <path d="M12.001 4.8c-3.2 0-5.2 1.6-6 4.8 1.2-1.6 2.6-2.2 4.2-1.8.913.228 1.565.89 2.288 1.624C13.666 10.618 15.027 12 18.001 12c3.2 0 5.2-1.6 6-4.8-1.2 1.6-2.6 2.2-4.2 1.8-.913-.228-1.565-.89-2.288-1.624C16.335 6.182 14.974 4.8 12.001 4.8zm-6 7.2c-3.2 0-5.2 1.6-6 4.8 1.2-1.6 2.6-2.2 4.2-1.8.913.228 1.565.89 2.288 1.624 1.177 1.194 2.538 2.576 5.512 2.576 3.2 0 5.2-1.6 6-4.8-1.2 1.6-2.6 2.2-4.2 1.8-.913-.228-1.565-.89-2.288-1.624C10.335 13.382 8.974 12 6.001 12z"/>
            </svg>
          )}

          {tech.icon === 'astro' && (
            <svg width="15" height="16" viewBox="0 0 24 24" fill="none" stroke={tech.color} stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"/>
              <path d="m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"/>
              <path d="M9 12H4s.55-3.03 2-4.5c1.62-1.63 5-2 5-2"/>
              <path d="M12 15v5s3.03-.55 4.5-2c1.63-1.62 2-5 2-5"/>
            </svg>
          )}

          {tech.icon === 'typescript' && (
            <svg width="16" height="16" viewBox="0 0 24 24" fill={tech.color}>
              <path d="M3 3h18v18H3V3zm8.3 12.3c0-2.1-1.3-3.1-3.6-3.7-.8-.2-1.3-.5-1.3-.9 0-.5.5-.8 1.3-.8.9 0 1.5.3 1.8.8l1.4-.9c-.6-.9-1.7-1.4-3.2-1.4-2 0-3.3 1.1-3.3 2.7 0 1.7 1 2.7 3.3 3.3.9.2 1.5.5 1.5 1 0 .6-.6.9-1.5.9-1.1 0-1.9-.4-2.2-1.1L4 15.6c.5 1.3 1.8 2 3.8 2 2.2 0 3.5-1.1 3.5-2.3zm8.5-6.8h-6.2v1.6h2.2v8.2h1.8v-8.2h2.2V8.5z"/>
            </svg>
          )}

          {tech.icon === 'docker' && (
            <svg width="17" height="16" viewBox="0 0 24 24" fill={tech.color}>
              <path d="M22.5 10.5c-.3-.2-1.7-.3-2.6.4-.3.2-.6.5-.8.9-.8-.2-2.1-.2-3.2.5-.2-.1-.5-.2-.8-.2-1.4 0-2.5 1-2.6 2.4H1c-.3 0-.6.2-.8.5-.6 1.4-.4 4.3 1.4 6.7 2 2.6 5.5 3.7 10.7 3.7 6.2 0 9.8-2.6 11.2-7.5.5-.3 1-.7 1.3-1.2.7-1.2.5-3.3-.4-4.8-.4-.3-1.3-.7-1.9-.7zm-14.8-1h1.8v1.7H7.7V9.5zm0-2.5h1.8v1.8H7.7V7zm2.5 2.5H12v1.7h-1.8V9.5zm0-2.5H12v1.8h-1.8V7zm2.5 2.5h1.8v1.7h-1.8V9.5zm0-2.5h1.8v1.8h-1.8V7zm2.5 2.5H17v1.7h-1.8V9.5zm-7.5 0H7V11H5.2V9.5z"/>
            </svg>
          )}

          {tech.icon === 'python' && (
            <svg width="16" height="16" viewBox="0 0 24 24" fill={tech.color}>
              <path d="M11.9 2c-3.1 0-2.9 1.3-2.9 1.3l.1 1.4h2.9v.4H6.2S4 4.8 4 8c0 3.2 1.8 3.3 1.8 3.3H7v-1.7c0-1.8 1.6-1.8 1.6-1.8h4.5s1.6.1 1.6-1.6V4.4s.2-2.4-2.8-2.4zm-1.6 1.1c.3 0 .6.3.6.6s-.3.6-.6.6-.6-.3-.6-.6.3-.6.6-.6zm1.8 18.9c3.1 0 2.9-1.3 2.9-1.3l-.1-1.4h-2.9v-.4h5.8s2.2.3 2.2-2.9c0-3.2-1.8-3.3-1.8-3.3H17v1.7c0 1.8-1.6 1.8-1.6 1.8h-4.5s-1.6-.1-1.6 1.6v1.8s-.2 2.4 2.8 2.4zm1.6-1.1c-.3 0-.6-.3-.6-.6s.3-.6.6-.6.6.3.6.6-.3.6-.6.6z"/>
            </svg>
          )}

          {tech.icon === 'redis' && (
            <svg width="17" height="16" viewBox="0 0 24 24" fill={tech.color}>
              <path d="M21.5 8.2L12.5 3a1 1 0 0 0-1 0L2.5 8.2a1 1 0 0 0 0 1.7l9 5.2a1 1 0 0 0 1 0l9-5.2a1 1 0 0 0 0-1.7zm-9.5 5.1L4.5 9 12 4.7 19.5 9 12 13.3zM2.5 14.1l9 5.2a1 1 0 0 0 1 0l9-5.2a1 1 0 0 0 0-1.7l-1.3-.8-7.7 4.5a1 1 0 0 1-1 0L3.8 11.6l-1.3.8a1 1 0 0 0 0 1.7z"/>
            </svg>
          )}

          <span class="tech-name">{tech.name}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .tech-stack-section {
    margin: 2rem 0 2.25rem;
    position: relative;
  }

  .tech-stack-head {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.85rem;
  }

  .tech-stack-title {
    font-size: var(--step--1);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--fg-muted);
  }

  .marquee-wrapper {
    position: relative;
    width: 100%;
    overflow: hidden;
    padding: 0.4rem 0;
    -webkit-mask-image: linear-gradient(to right, transparent, black 8%, black 92%, transparent);
    mask-image: linear-gradient(to right, transparent, black 8%, black 92%, transparent);
  }

  .marquee-track {
    display: flex;
    gap: 0.75rem;
    width: max-content;
    animation: scroll-left 45s linear infinite;
  }

  .marquee-wrapper:hover .marquee-track {
    animation-play-state: paused;
  }

  /* Exact border-radius and styling matching .pill-btn with translucent glass look */
  .tech-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.5rem 0.95rem;
    background-color: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-radius: var(--radius-xs);
    font-size: var(--step--1);
    font-weight: 500;
    color: var(--fg);
    white-space: nowrap;
    transition: all 0.25s ease;
    user-select: none;
    cursor: default;
  }

  .tech-pill:hover {
    background-color: rgba(255, 255, 255, 0.06);
    border-color: rgba(255, 255, 255, 0.2);
    transform: translateY(-1px);
  }

  .tech-pill svg {
    flex-shrink: 0;
  }

  .tech-name {
    letter-spacing: 0.01em;
  }

  @keyframes scroll-left {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(calc(-50% - 0.325rem));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
      flex-wrap: wrap;
    }
  }
</style>
