---
// Astro Narrow Floating Dock Toolbar with Integrated Search
---

<div class="dock-shell" id="floatingDock">
  <!-- Back Button -->
  <button type="button" class="dock-btn" id="dockBack" aria-label="Go Back" title="Go Back">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="m12 19-7-7 7-7"/><path d="M19 12H5"/>
    </svg>
  </button>

  <!-- Home Button -->
  <a href="/" class="dock-btn" aria-label="Home" title="Home">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8"/><path d="M3 10a2 2 0 0 1 .709-1.528l7-6a2 2 0 0 1 2.582 0l7 6A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
    </svg>
  </a>

  <!-- Search Button -->
  <button type="button" class="dock-btn" id="dockSearch" aria-label="Search" title="Search site (Ctrl + K)">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>
    </svg>
  </button>

  <!-- Scroll To Top Button -->
  <button type="button" class="dock-btn" id="dockScrollTop" aria-label="Scroll to top" title="Scroll to top">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="m18 15-6-6-6 6"/>
    </svg>
  </button>
</div>

<script>
  // Dock Back Action
  const backBtn = document.getElementById('dockBack');
  if (backBtn) {
    backBtn.addEventListener('click', () => {
      if (window.history.length > 1) {
        window.history.back();
      } else {
        window.location.href = '/';
      }
    });
  }

  // Dock Search Action
  const searchBtn = document.getElementById('dockSearch');
  if (searchBtn) {
    searchBtn.addEventListener('click', () => {
      if (typeof (window as any).openNetSpaceSearch === 'function') {
        (window as any).openNetSpaceSearch();
      }
    });
  }

  // Dock Scroll Top
  const topBtn = document.getElementById('dockScrollTop');
  if (topBtn) {
    topBtn.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  }
</script>
