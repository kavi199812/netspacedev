---
// Recent Posts Slider Component
// Responsive: 3 columns on PC, 2 columns on Tablet, 1 column on Mobile
// Features: CSS Scroll Snap, Left/Right controls, and touch swipe
interface Props {
  blogs: Array<{
    title: string;
    slug: string;
    excerpt?: string;
    category?: string;
    created_at?: string;
    cover_image?: string;
    tags?: string;
    read_time?: string;
  }>;
}

const { blogs = [] } = Astro.props;
---

<section class="posts-slider-section" aria-label="Recent Posts Carousel">
  <div class="slider-header-row">
    <div>
      <h2 class="content-section-title" style="margin-bottom: 0.2rem;">Recent Posts</h2>
      <p class="slider-subtitle">Latest engineering insights, architecture guides, and tech releases.</p>
    </div>

    <!-- Navigation Arrows -->
    <div class="slider-controls">
      <button type="button" id="blogSliderPrev" class="slider-nav-btn" aria-label="Previous posts" title="Previous">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="m15 18-6-6 6-6"/>
        </svg>
      </button>
      <button type="button" id="blogSliderNext" class="slider-nav-btn" aria-label="Next posts" title="Next">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="m9 18 6-6-6-6"/>
        </svg>
      </button>
    </div>
  </div>

  <!-- The Slider Track -->
  <div id="blogSliderTrack" class="slider-track" tabindex="0" role="region" aria-label="Posts slider track">
    {blogs.map((b) => (
      <article class="slider-item">
        <a href={`/blog#${b.slug}`} class="post-card-inner">
          {b.cover_image && (
            <div class="post-thumb-wrapper">
              <img src={b.cover_image} alt={b.title} class="post-thumb-img" loading="lazy" />
              {b.category && <span class="post-cat-badge">{b.category}</span>}
            </div>
          )}

          <div class="post-card-content">
            <h3 class="post-card-title">{b.title}</h3>
            {b.excerpt && <p class="post-card-excerpt">{b.excerpt}</p>}

            <div class="post-card-footer">
              <span class="post-date">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect width="18" height="18" x="3" y="4" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/>
                </svg>
                <time>{b.created_at ? new Date(b.created_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : 'Recent'}</time>
              </span>

              <span class="post-read-link">
                Read
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 12h14m-7-7 7 7-7 7"/>
                </svg>
              </span>
            </div>
          </div>
        </a>
      </article>
    ))}
  </div>

  <!-- View All Button -->
  <div class="view-all-wrap">
    <a href="/blog" class="view-all-btn">
      <span>View all posts</span>
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M5 12h14m-7-7 7 7-7 7"/>
      </svg>
    </a>
  </div>
</section>

<script is:inline>
  (() => {
    const track = document.getElementById('blogSliderTrack');
    const prevBtn = document.getElementById('blogSliderPrev');
    const nextBtn = document.getElementById('blogSliderNext');

    if (!track || !prevBtn || !nextBtn) return;

    function getSlideStep() {
      const firstItem = track.querySelector('.slider-item');
      if (!firstItem) return 300;
      return firstItem.getBoundingClientRect().width + 16; // width + gap
    }

    prevBtn.addEventListener('click', () => {
      track.scrollBy({ left: -getSlideStep(), behavior: 'smooth' });
    });

    nextBtn.addEventListener('click', () => {
      track.scrollBy({ left: getSlideStep(), behavior: 'smooth' });
    });
  })();
</script>

<style>
  .posts-slider-section {
    margin-top: 4.5rem;
    margin-bottom: 5.5rem;
  }

  @media (max-width: 767px) {
    .posts-slider-section {
      margin-top: 3.25rem;
      margin-bottom: 4rem;
    }
  }

  .slider-header-row {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }

  .slider-subtitle {
    font-size: var(--step--1);
    color: var(--fg-muted);
    margin: 0;
  }

  .slider-controls {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .slider-nav-btn {
    width: 36px;
    height: 36px;
    display: grid;
    place-items: center;
    border-radius: var(--radius-xs);
    border: 1px solid var(--border);
    background-color: var(--surface);
    color: var(--fg);
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .slider-nav-btn:hover {
    background-color: var(--hover);
    border-color: var(--border-strong);
    transform: translateY(-1px);
  }

  /* 
   * Responsive Slider Track:
   * PC (>=900px): 3 columns
   * Tablet (600px - 899px): 2 columns
   * Mobile (<600px): 1 column
   */
  .slider-track {
    display: flex;
    gap: 1rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    padding-bottom: 0.85rem;
    padding-top: 0.25rem;
    scrollbar-width: thin;
    scrollbar-color: var(--border) transparent;
  }

  .slider-track::-webkit-scrollbar {
    height: 6px;
  }

  .slider-track::-webkit-scrollbar-track {
    background: transparent;
  }

  .slider-track::-webkit-scrollbar-thumb {
    background: var(--border);
    border-radius: 999px;
  }

  /* Default PC: 3 Columns */
  .slider-item {
    flex: 0 0 calc((100% - 2rem) / 3);
    min-width: 0;
    scroll-snap-align: start;
    box-sizing: border-box;
  }

  /* Tablet: 2 Columns */
  @media (max-width: 899px) and (min-width: 600px) {
    .slider-item {
      flex: 0 0 calc((100% - 1rem) / 2);
    }
  }

  /* Mobile: 1 Column */
  @media (max-width: 599px) {
    .slider-item {
      flex: 0 0 100%;
    }
  }

  /* Post Card Styling */
  .post-card-inner {
    display: flex;
    flex-direction: column;
    height: 100%;
    border: 1px solid var(--border);
    background-color: var(--surface);
    border-radius: var(--radius);
    overflow: hidden;
    text-decoration: none;
    color: var(--fg);
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .post-card-inner:hover {
    border-color: var(--border-strong);
    background-color: var(--hover);
    transform: translateY(-3px);
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.2);
  }

  [data-theme="light"] .post-card-inner:hover {
    box-shadow: 0 10px 24px rgba(15, 23, 42, 0.08);
  }

  .post-thumb-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background-color: #0c0f14;
  }

  .post-thumb-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .post-card-inner:hover .post-thumb-img {
    transform: scale(1.05);
  }

  .post-cat-badge {
    position: absolute;
    top: 0.65rem;
    left: 0.65rem;
    background: rgba(12, 15, 20, 0.85);
    color: var(--accent-text);
    border: 1px solid rgba(255, 255, 255, 0.12);
    backdrop-filter: blur(8px);
    font-size: 0.7rem;
    font-weight: 600;
    padding: 0.2rem 0.55rem;
    border-radius: var(--radius-xs);
    letter-spacing: 0.02em;
  }

  .post-card-content {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 1.1rem 1.15rem 1.15rem;
    gap: 0.6rem;
  }

  .post-card-title {
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.35;
    letter-spacing: -0.01em;
    color: var(--fg);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin: 0;
  }

  .post-card-excerpt {
    font-size: 0.825rem;
    color: var(--fg-muted);
    line-height: 1.55;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin: 0;
    flex: 1;
  }

  .post-card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 0.5rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--border);
    font-size: 0.75rem;
    color: var(--fg-muted);
  }

  .post-date {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .post-read-link {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    color: var(--accent-text);
    font-weight: 600;
    transition: transform 0.2s ease;
  }

  .post-card-inner:hover .post-read-link {
    transform: translateX(3px);
  }
</style>
