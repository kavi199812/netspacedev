# NetSpace Dev - Environment Configuration
# Copy this file to .env and fill in your credentials

# Database Configuration (Hostinger / cPanel MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=netspace
DB_USER=root
DB_PASS=

# Production Domain Settings (Optional)
SITE_URL=https://netspacedev.com

# Hostinger Titan / Business Mail SMTP Settings (Port 465 SSL)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=ssl
SMTP_USER=hello@netspacedev.com
SMTP_PASS=your_email_password_here

# Email Notification Settings (Contact Form Submissions)
CONTACT_TO_EMAIL=hello@netspacedev.com
CONTACT_FROM_EMAIL=hello@netspacedev.com
CONTACT_FROM_NAME="NetSpace Dev"
